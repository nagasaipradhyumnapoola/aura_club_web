# Supabase (server-side only — never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Cloudflare Turnstile secret. When set, /api/apply requires a valid `turnstileToken`.
TURNSTILE_SECRET_KEY=

# Local testing only: validates + accepts applications without writing to a database.
# Never enable in production.
AURA_DRY_RUN=false
